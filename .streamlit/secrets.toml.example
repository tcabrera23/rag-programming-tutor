# =============================================================================
# Streamlit Cloud Secrets Configuration
# =============================================================================
# Este archivo es un TEMPLATE. NO lo subas a GitHub.
# En Streamlit Cloud, configura estos secrets en: Settings → Secrets
#
# Formato TOML para Streamlit Cloud
# =============================================================================

# -----------------------------------------------------------------------------
# Groq (Gratis - Recomendado para empezar)
# -----------------------------------------------------------------------------
# Obtén tu API key gratis en: https://console.groq.com/keys
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# OpenRouter (Opcional - Solo si usas modelos de pago)
# -----------------------------------------------------------------------------
# Obtén tu API key en: https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Postgres + pgvector (RAG)
# -----------------------------------------------------------------------------
# En local, Docker Compose usa chatpdep:chatpdep. En Streamlit Cloud
# apuntá a un Postgres propio con el schema de db/schema.sql.
DATABASE_URL = "postgresql://chatpdep:chatpdep@localhost:5432/chatpdep"

# Métricas opcionales (el RAG no las usa)
# SUPABASE_URL = "https://xxxxxxxxxxxxx.supabase.co"
# SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx"

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. GROQ_API_KEY es GRATIS y suficiente para empezar
#    - Llama 3.3 70B, Mixtral 8x7B gratis
#    - Sin límite de tokens en tier gratuito
#    - Ideal para demo y uso personal
#
# 2. OPENROUTER_API_KEY es opcional
#    - Solo necesaria si quieres modelos premium (GPT-4, Claude)
#    - Tiene costo por uso
#
# 3. Ollama NO funciona en Streamlit Cloud
#    - Solo funciona en local con Docker
#    - En cloud usa Groq o OpenRouter
#
# 4. Streamlit Cloud no tiene persistencia de archivos
#    - Las conversaciones NO se guardan entre sesiones
#    - Solo se mantienen durante la sesión del navegador
#    - Para persistencia, usa login + Supabase (próxima versión)
#
# =============================================================================
# CONFIGURACIÓN EN STREAMLIT CLOUD
# =============================================================================
#
# 1. Ve a tu app en Streamlit Cloud
# 2. Settings → Secrets
# 3. Copia y pega este contenido (con tus keys reales)
# 4. Save
# 5. La app se reiniciará automáticamente
#
# Ejemplo de cómo se ve en Streamlit Cloud:
#
# GROQ_API_KEY = "gsk_tu_key_real_aqui"
# OPENROUTER_API_KEY = "sk-or-v1-tu_key_real_aqui"
# DATABASE_URL = "postgresql://chatpdep:chatpdep@localhost:5432/chatpdep"
#
# =============================================================================
