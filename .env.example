# =============================================================================
# ChatPdeP - Variables de Entorno
# =============================================================================

# -----------------------------------------------------------------------------
# Groq (Gratis - Recomendado)
# -----------------------------------------------------------------------------
# Obtén tu API key gratis en: https://console.groq.com/keys
# Ideal para empezar sin costo
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OpenRouter (Cloud Models de Pago)
# -----------------------------------------------------------------------------
# Obtén tu API key en: https://openrouter.ai/keys
# Opcional si solo usas Groq o Ollama local
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Supabase (RAG)
# -----------------------------------------------------------------------------
# URL del proyecto y ANON KEY (RLS). No uses SERVICE_KEY en la app.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# Ollama (Local Models)
# -----------------------------------------------------------------------------
# URL del servidor Ollama
# - Docker: http://ollama:11434 (automático en docker-compose)
# - Local: http://localhost:11434
# - Remoto: http://ip-servidor:11434
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Notas de Configuración
# =============================================================================

# OPENROUTER_API_KEY:
# - Necesaria SOLO si usas modelos cloud (Gemini, GPT, Claude, Grok)
# - NO necesaria si solo usas Ollama local
# - Puedes también configurarla desde el sidebar de la app

# OLLAMA_BASE_URL:
# - En Docker Compose: se configura automáticamente a http://ollama:11434
# - En local sin Docker: http://localhost:11434
# - Si Ollama está en otra máquina: http://ip-de-la-maquina:11434

# Modelos Sugeridos para Ollama:
# - phi4-mini (3.8B) - Instalado por defecto en Docker
# - qwen3-4b - Excelente para código, balanceado
# - deepseek-coder-6.7b - Especialista en programación
# - qwen2.5-coder-7b - Muy potente para desarrollo

# Para instalar modelos adicionales (en Docker):
# docker exec -it chatpdep_ollama ollama pull qwen3-4b
# docker exec -it chatpdep_ollama ollama pull deepseek-coder-6.7b
